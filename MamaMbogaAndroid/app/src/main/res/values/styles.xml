<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/forest_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/fresh_lime</item>
        <item name="colorOnSecondary">@color/forest_green_deep</item>
        <item name="colorTertiary">@color/papaya_orange</item>
        <item name="colorOnTertiary">@color/deep_charcoal</item>
        <item name="colorSurface">@color/warm_cream</item>
        <item name="colorOnSurface">@color/deep_charcoal</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/warm_cream</item>
        <item name="android:navigationBarColor">@color/warm_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialButtonStyle">@style/Widget.MamaMboga.Button</item>
    </style>

    <style name="Widget.MamaMboga.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MamaMboga.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/line_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
