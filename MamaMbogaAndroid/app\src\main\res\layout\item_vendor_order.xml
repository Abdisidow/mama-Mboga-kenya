<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/line_soft"
    app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
        <TextView android:id="@+id/customerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/deep_charcoal" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/orderMetadata" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/muted_green" android:textSize="12sp" />
        <TextView android:id="@+id/orderItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/deep_charcoal" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/orderTotal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/forest_green" android:textSize="15sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/confirmOrderButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="@string/confirm_order" android:textSize="11sp" app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
